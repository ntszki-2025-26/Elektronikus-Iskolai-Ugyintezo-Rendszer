@page "/admin"
@rendermode InteractiveServer

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />

@* Needed for dialogs *@
<MudDialogProvider />

@* Needed for snackbars *@
<MudSnackbarProvider />




	

    <MudLayout>
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="@ToggleDrawer" />
            <MudSpacer />
        <MudDrawer @bind-Open="@_open" Elevation="1" Variant="DrawerVariant.Temporary">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">Elektronikus Iskolai Ügyintéző Rendszer</MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Match="NavLinkMatch.All">Profil</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All">Értesítések</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All">Kilépés</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        <MudMainContent Class="pt-16 px-16">
            <MudContainer Class="mt-6">
                <div class="designbox">
                    <h1 class="title">Admin page</h1>
                    <MudTextField @bind-Value="userModel.Nev" Label="Név*" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="userModel.Email" Label="Email*" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="userModel.Lakhely" Label="Lakhely*" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="userModel.OMAzonosito" Label="OM Azonosító" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="userModel.Evfolyam" Label="Évfolyam" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="userModel.Jogosultsag" Label="Jogosultság*" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="userModel.Telefonszam" Label="Telefonszám*" Variant="Variant.Outlined" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary">Hozzáadás</MudButton>
                </div>
            </MudContainer>
        </MudMainContent>
    </MudLayout>




@code {
    private UserModel userModel = new();

    private void HandleValidSubmit()
    {
        Console.WriteLine("Felhasználó hozzáadva:");
        Console.WriteLine(userModel.Nev);
        Console.WriteLine(userModel.Email);
    }

    public class UserModel
    {
        public string Nev { get; set; }
        public string Email { get; set; }
        public string Lakhely { get; set; }
        public string OMAzonosito { get; set; }
        public int? Evfolyam { get; set; }
        public string Jogosultsag { get; set; }
        public string Telefonszam { get; set; }
    }

    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}