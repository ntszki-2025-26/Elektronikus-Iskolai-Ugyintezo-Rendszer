@page "/DiakHome"
@rendermode InteractiveServer
@inject ISnackbar Snackbar
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Data
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Diák")]
@using Elektronikus_Iskolai_Ugyintezo_Rendszer
@using Microsoft.AspNetCore.Components.Authorization
@inject IDialogService DialogService
@inject RequestService RequestService
@inject UserManagementService UserManagementService
@inject GetRequestService GetReq
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider IsDarkMode="false" />


<MudLayout>
    <MudDrawer Open="true" Elevation="0" Variant="@DrawerVariant.Responsive">
        <MudDrawerHeader Class="pa-8">
            <MudButton Typo="Typo.h5"
                       Style="color: black; font-weight: 800;">
               @StudentName
            </MudButton>
        </MudDrawerHeader>

        <MudNavMenu Class="nav-menu-custom">

            <div class="logout-wrapper">
                <div class="logout-btn-box">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-3" />
                    <span>Kijelentkezés</span>
                </div>
            </div>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="main-bg">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-10">
            <MudText Typo="Typo.h4" Class="mb-8" Style="font-weight: 800; color: #1a202c;">Feladatok</MudText>

            <MudGrid>
                @foreach (var item in GetMenuItems())
                {
                    <MudItem xs="12" sm="6" md="4">
                        <div class="custom-card" @onclick="item.Action">
                            <div class="card-accent" style="background-color: @item.Color;"></div>
                            <div class="card-body">
                                <div class="d-flex flex-column">
                                    <MudText Typo="Typo.caption" Style="color: #718096; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Ügyintézés</MudText>
                                    <MudText Typo="Typo.subtitle1" Class="card-title-text">@item.Title</MudText>
                                </div>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForwardIos" Size="Size.Small" Style="color: #cbd5e0;" />
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>

            <div class="mt-12">
                <MudText Typo="Typo.h5" Class="mb-6" Style="font-weight: 800; color: #1a202c;">
                    Kérelmek állapota
                </MudText>

                <MudTable Items="@requests" Hover="true" Elevation="0" Class="rounded-xl border border-solid mud-border-default shadow-sm">
                    <HeaderContent>
                        <MudTh Style="font-weight: 700;">Típus</MudTh>
                        <MudTh Style="font-weight: 700;">Dátum</MudTh>
                        <MudTh Style="font-weight: 700;">Állapot</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Title</MudTd>
                        <MudTd>@context.ReportDate.ToString("yyyy.MM.dd.")</MudTd>
                        <MudTd>
                            <MudChip T="string"
                                     Color="@GetStatusColor(context.State)"
                                     Variant="Variant.Text"
                                     Size="Size.Small"
                                     Style="font-weight: 800; background-color: rgba(0,0,0,0.03);">
                                @GetStatusText(context.State)
                            </MudChip>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>


@code {

    private List<Taskses> requests = new();

    private class MenuItem
    {
        public string Title { get; set; } = "";
        public Func<Task> Action { get; set; } = default!;
        public string Color { get; set; } = "#594ae2";
    }

    private List<MenuItem> GetMenuItems() => new()
    {
        new MenuItem { Title = "Iskolalátogatási igazolás", Action = Iskolalatogatas, Color = "#2196F3" },
        new MenuItem { Title = "Jogviszony igazolás", Action = Jogviszony, Color = "#4CAF50" },
        new MenuItem { Title = "MÁK / Árvásági dokumentum", Action = MAKarvasagi, Color = "#FF9800" },
        new MenuItem { Title = "Érettségi", Action = Erettsegi, Color = "#E91E63" },
        new MenuItem { Title = "Lakcím bejelentés", Action = Lakcim, Color = "#9C27B0" },
        new MenuItem { Title = "Törzslap másolat", Action = Torzslap, Color = "#795548" },
        new MenuItem { Title = "Hiányzás bejelentése", Action = Hianyzas, Color = "#751915" },
    };

    private Task Iskolalatogatas() => DialogService.ShowAsync<Pages.Dialogok.IskolaLatDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task MAKarvasagi() => DialogService.ShowAsync<Pages.Dialogok.MAKDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task Jogviszony() => DialogService.ShowAsync<Pages.Dialogok.JogviszonyDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task Erettsegi() => DialogService.ShowAsync<Pages.Dialogok.ErettsegiDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task Lakcim() => DialogService.ShowAsync<Pages.Dialogok.LakcimDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task Torzslap() => DialogService.ShowAsync<Pages.Dialogok.TorzslapDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task Hianyzas() => DialogService.ShowAsync<Pages.Dialogok.HianyzasDialog>("", new DialogOptions { CloseOnEscapeKey = true });

    private Task ProfileDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };


        return DialogService.ShowAsync<ProfileDialog>("", options);
    }

    private string GetStatusText(int? status) => status switch
    {
        0 => "Beérkezett",
        1 => "Folyamatban",
        2 => "Elkészült",
        _ => "Ismeretlen"
    };


    @*private List<RequestItem> GetRequests() => new()
    {
        new RequestItem { Type = "Iskolalátogatási igazolás", Date = DateTime.Now.AddDays(-2), Status = 2 },
        new RequestItem { Type = "Érettségi jelentkezés", Date = DateTime.Now.AddDays(-1), Status = 1 },
        new RequestItem { Type = "Lakcím bejelentés", Date = DateTime.Now, Status = 0 }

    };*@


    private Color GetStatusColor(int status) => status switch
    {
        2 => Color.Success,  
        1 => Color.Warning, 
        0 => Color.Error,   
        _ => Color.Default
    };

    private async Task IskolalatogatasiKerese()
    {

        var ujKerelem = new Elektronikus_Iskolai_Ugyintezo_Rendszer.Models.Taskses
        {
            Title = "Iskolalátogatási igazolás",
            TaskTypeId = 1,
            ReportDate = DateTime.Now,
            Message = "Iskolalátogatási papírt szeretnék kérni.",
            SenderUserId = Guid.Empty
        };

        await RequestService.AddRequestAsync(ujKerelem);
        Snackbar.Add("Kérelem elküldve!", MudBlazor.Severity.Success);
    }


    private string StudentName { get; set; } = "Betöltés...";

    protected override async Task OnInitializedAsync()
    {
        StudentName = await UserManagementService.GetCurrentUserNameAsync();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (Guid.TryParse(userIdStr, out var userId))
        {

            requests = await GetReq.GetDiakTasks(userId);
        }
    }
}
