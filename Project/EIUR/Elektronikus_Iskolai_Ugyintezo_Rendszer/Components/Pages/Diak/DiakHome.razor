@page "/DiakHome"
@rendermode InteractiveServer
@inject ISnackbar Snackbar
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Data
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Diák")]
@using Elektronikus_Iskolai_Ugyintezo_Rendszer
@using Microsoft.AspNetCore.Components.Authorization
@inject IDialogService DialogService
@inject RequestService RequestService
@inject UserManagementService UserManagementService
@inject GetRequestService GetReq
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<MudThemeProvider IsDarkMode="false" />

<MudLayout>
    <MudDrawer Open="true" Elevation="1" Variant="@DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Class="sidebar-dark d-none d-md-flex">
        <div class="pa-8 d-flex flex-column align-center" style="border-bottom: 1px solid rgba(255,255,255,0.1); width: 100%;">
            <MudIcon Icon="@Icons.Material.Filled.School" Style="font-size: 3.5rem; color: #2196F3 !important;" />
            <div @onclick="ProfileDialog" style="cursor: pointer;" class="mt-4 d-flex align-center justify-center">
                <MudText Typo="Typo.h6" Style="color: black !important; font-weight: 800; line-height: 1.2;">
                    @StudentName
                </MudText>
            </div>
        </div>

        <MudNavMenu Class="nav-menu-custom">
            <div class="pa-4 mt-auto">
                <div class="logout-btn-box" @onclick="HandleLogout" style="cursor: pointer;">
                    <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-3" />
                    <span>Kijelentkezés</span>
                </div>
            </div>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="main-bg-fix">
        <div class="custom-mobile-header d-md-none">
            <div class="header-left-side">
                <div @onclick="ProfileDialog" style="cursor: pointer;" class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Class="mr-2" />
                    <span class="student-name-display">@StudentName</span>
                </div>
            </div>
            <div class="header-right-side">
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Error" OnClick="HandleLogout" Size="Size.Small" />
            </div>
        </div>

        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4 pa-md-10 content-wrapper-fix">
            <MudText Typo="Typo.h4" Class="mb-8 d-none d-md-block" Style="font-weight: 800; color: #1a202c;">Kérelmek</MudText>
            
            <MudGrid Spacing="3">
                @foreach (var item in GetMenuItems())
                {
                    <MudItem xs="12" sm="6" md="4">
                        <div class="custom-card" @onclick="item.Action" style="cursor: pointer;">
                            <div class="card-accent" style="background-color: @item.Color;"></div>
                            <div class="card-body">
                                <div class="d-flex flex-column">
                                    <MudText Typo="Typo.caption" Style="color: #718096; font-weight: 600; text-transform: uppercase;">Ügyintézés</MudText>
                                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@item.Title</MudText>
                                </div>
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Style="color: #cbd5e0;" />
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>

            <div class="mt-10">
                <div class="d-flex flex-column flex-md-row align-md-center justify-md-space-between mb-6 gap-4">
                    <div class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Info" Class="mr-2" />
                        <MudText Typo="Typo.h5" Style="font-weight: 800; color: #1a202c;">Kérelmek állapota</MudText>
                    </div>

                    <div style="min-width: 280px;">
                        <MudSelect T="int?" Label="Állapot szűrése" Value="@selectedStatus" ValueChanged="OnStatusChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" Class="bg-white rounded-lg shadow-sm">
                            <MudSelectItem T="int?" Value="@((int?)null)">Összes beküldött</MudSelectItem>
                            <MudSelectItem T="int?" Value="@(0)">Beérkezett</MudSelectItem>
                            <MudSelectItem T="int?" Value="@(1)">Folyamatban</MudSelectItem>
                            <MudSelectItem T="int?" Value="@(3)">Titkársági aláírás szükséges</MudSelectItem>
                            <MudSelectItem T="int?" Value="@(2)">Elkészült</MudSelectItem>
                        </MudSelect>
                    </div>
                </div>

                <div class="table-container">
                    <MudTable Items="@FilteredRequests" Hover="true" Elevation="0" Class="rounded-xl border shadow-sm custom-table">
                        <HeaderContent>
                            <MudTh>Típus</MudTh>
                            <MudTh>Dátum</MudTh>
                            <MudTh>Állapot</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Típus">@context.Title</MudTd>
                            <MudTd DataLabel="Dátum">@context.ReportDate.ToString("yyyy.MM.dd.")</MudTd>
                            <MudTd DataLabel="Állapot">
                                <MudChip T="string"
                                         Color="@GetStatusColor(context.State)"
                                         Variant="Variant.Text"
                                         Size="Size.Small"
                                         Style="font-weight: 800;">
                                    @GetStatusText(context.State)
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private string StudentName { get; set; } = "Betöltés...";
    private List<Taskses> requests = new();
    private int? selectedStatus = null;

    private IEnumerable<Taskses> FilteredRequests => selectedStatus.HasValue
        ? requests.Where(x => x.State == selectedStatus.Value)
        : requests;

    private void OnStatusChanged(int? newValue)
    {
        selectedStatus = newValue;
        StateHasChanged();
    }

    private void HandleLogout() => Nav.NavigateTo("/", forceLoad: true);

    private class MenuItem
    {
        public string Title { get; set; } = "";
        public Func<Task> Action { get; set; } = default!;
        public string Color { get; set; } = "#594ae2";
    }

    private List<MenuItem> GetMenuItems() => new()
    {
        new MenuItem { Title = "Iskolalátogatási igazolás", Action = Iskolalatogatas, Color = "#2196F3" },
        new MenuItem { Title = "Jogviszony igazolás", Action = Jogviszony, Color = "#4CAF50" },
        new MenuItem { Title = "MÁK / Árvásági dokumentum", Action = MAKarvasagi, Color = "#FF9800" },
        new MenuItem { Title = "Érettségi jelentkezés", Action = Erettsegi, Color = "#E91E63" },
        new MenuItem { Title = "Lakcím bejelentés", Action = Lakcim, Color = "#9C27B0" },
        new MenuItem { Title = "Törzslap másolat", Action = Torzslap, Color = "#795548" },
        new MenuItem { Title = "Hiányzás bejelentése", Action = Hianyzas, Color = "#751915" },
    };

    private Task Iskolalatogatas() => DialogService.ShowAsync<Pages.Dialogok.IskolaLatDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task MAKarvasagi() => DialogService.ShowAsync<Pages.Dialogok.MAKDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task Jogviszony() => DialogService.ShowAsync<Pages.Dialogok.JogviszonyDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task Erettsegi()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Small };
        return DialogService.ShowAsync<Pages.Dialogok.ErettsegiDialog>("", options);
    }
    private Task Lakcim() => DialogService.ShowAsync<Pages.Dialogok.LakcimDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task Torzslap() => DialogService.ShowAsync<Pages.Dialogok.TorzslapDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task Hianyzas() => DialogService.ShowAsync<Pages.Dialogok.HianyzasDialog>("", new DialogOptions { CloseOnEscapeKey = true });
    private Task ProfileDialog() => DialogService.ShowAsync<Pages.Dialogok.ProfileDialog>("", new DialogOptions { CloseOnEscapeKey = true });

    private string GetStatusText(int? status) => status switch
    {
        0 => "Beérkezett",
        1 => "Folyamatban",
        2 => "Elkészült",
        3 => "Titkársági aláírás szükséges",
        _ => "Ismeretlen"
    };

    private Color GetStatusColor(int? status) => status switch
    {
        3 => Color.Secondary,
        2 => Color.Success,
        1 => Color.Warning,
        0 => Color.Error,
        _ => Color.Default
    };

    protected override async Task OnInitializedAsync()
    {
        StudentName = await UserManagementService.GetCurrentUserNameAsync();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (Guid.TryParse(userIdStr, out var userId))
        {
            requests = await GetReq.GetDiakTasks(userId);
        }
    }
}