@page "/DiakHome"
@rendermode InteractiveServer
@using Elektronikus_Iskolai_Ugyintezo_Rendszer
@inject IDialogService DialogService

<MudThemeProvider />
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

<MudPaper Width="250px" Elevation="0">
    <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="pa-2">
        <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
        <MudNavLink Match="NavLinkMatch.Prefix" Href="/components/navmenu" Icon="@Icons.Material.Filled.Storage">Servers</MudNavLink>
        <MudNavLink Href="/thelab" Icon="@Icons.Material.Filled.Science">The Lab</MudNavLink>
    </MudNavMenu>
</MudPaper>



<div class="menu-container">
    <MudButton @onclick="Iskolalatogatas" Variant="Variant.Filled" Color="Color.Primary">
        Iskolalátogatási igazolás magyar, német
    </MudButton>
   <MudButton @onclick="Jogviszony" Variant="Variant.Filled" Color="Color.Primary">
        Jogviszony igazolás
    </MudButton>
    <MudButton @onclick="MAKarvasagi" Variant="Variant.Filled" Color="Color.Primary">
        MÁK igazolás / árvásági dokumentum
    </MudButton>
    <MudButton @onclick="Erettsegi" Variant="Variant.Filled" Color="Color.Primary">
        Érettségi vizsga adatbegyűjtés
    </MudButton>
    <MudButton @onclick="Lakcim" Variant="Variant.Filled" Color="Color.Primary">
        Lakcím adatok változásának bejelentése
    </MudButton>
    <MudButton @onclick="Korabbierettsegi" Variant="Variant.Filled" Color="Color.Primary">
        Korábbi érettségi vizsgák törzslap másolata
    </MudButton>

</div>

@code {
    private Task Iskolalatogatas()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        return DialogService.ShowAsync<Pages.IskolaLatDialog>("");

    }
    private Task MAKarvasagi()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        return DialogService.ShowAsync<Pages.JogviszonyDialog>("");
    }
    private Task Jogviszony()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        return DialogService.ShowAsync<Pages.ErettsegiDialog>("");
    }
    private Task Erettsegi()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        return DialogService.ShowAsync<Pages.KorabbiErettsegiDialog>("");
    }
    private Task Lakcim()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        return DialogService.ShowAsync<Pages.LakcimDialog>("");
    }
    private Task Korabbierettsegi()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        return DialogService.ShowAsync<Pages.KorabbiErettsegiDialog>("");
    }
 }