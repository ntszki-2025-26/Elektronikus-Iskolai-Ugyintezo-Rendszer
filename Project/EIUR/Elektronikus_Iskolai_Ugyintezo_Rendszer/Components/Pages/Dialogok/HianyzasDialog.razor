@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Services

@inject ITaskService TaskService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Home" Class="mr-3 mb-n1" />
            Hiányzás bejelentés
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-4">Kérjük, adja meg a hiányzás kezdeti, illetve az utolsó napját.</MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Mettől" @bind-Date="dateFrom" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Meddig" @bind-Date="dateTo" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField Label="Indoklás" @bind-Value="message" Variant="Variant.Outlined" Lines="3" FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">MÉGSE</MudButton>
        <MudButton Variant="Variant.Filled"
                   EndIcon="@Icons.Material.Filled.Send"
                   Color="Color.Primary"
                   OnClick="Submit">
            HIÁNYZÁS LEADÁSA
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudBlazor.IMudDialogInstance MudDialog { get; set; } = default!;

    // A MudDatePicker nullable DateTime-ot vár (DateTime?)
    private DateTime? dateFrom = DateTime.Now;
    private DateTime? dateTo = DateTime.Now;
    private string message = "";

    // A metódus async Task legyen, és NE várjon bemeneti paramétereket,
    // hanem a fenti globális változókat használja!
    private async Task Submit()
    {
        // Védelem: csak akkor küldjük el, ha mindkét dátum ki van választva
        if (dateFrom.HasValue && dateTo.HasValue)
        {
            // A .Value-val megkapjuk a tényleges DateTime értéket
            var siker = await TaskService.HianyzasHandle(dateFrom.Value, dateTo.Value, message);
            
            if (siker)
            {
                Snackbar.Add("Hiányzás sikeresen rögzítve!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add("Hiba történt a rögzítés során!", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add("Kérjük, töltse ki a dátumokat!", Severity.Warning);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}