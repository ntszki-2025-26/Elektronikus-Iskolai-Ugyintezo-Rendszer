@using MudBlazor
@inject ITaskService TaskService
@inject ISnackbar Snackbar


<MudDialog Class="custom-dialog-container">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-3" Color="Color.Info" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Iskolalátogatási igazolás</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="dialog-body">
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: #718096;">
                Kérjük, válassza ki, milyen nyelven szeretné igényelni az igazolást.
            </MudText>

            <MudSelect @bind-Value="_value"
                       Label="Nyelv kiválasztása"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomCenter"
                       AdornmentIcon="@Icons.Material.Filled.Language"
                       AdornmentColor="Color.Primary">
                @foreach (var nyelv in _nyelvek)
                {
                    <MudSelectItem Value="@nyelv">@nyelv</MudSelectItem>
                }
            </MudSelect>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="d-flex justify-end gap-2 pa-4 w-100">
            <MudButton OnClick="Cancel" Variant="Variant.Text" Class="action-btn">Mégse</MudButton>

            <MudButton OnClick="Submit"
                       Variant="Variant.Filled"
                       EndIcon="@Icons.Material.Filled.Download"
                       Disabled="@(string.IsNullOrEmpty(_value))"
                       Class="action-btn">
                Igénylés leadása
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    private MudBlazor.IMudDialogInstance MudDialog { get; set; } = default!;

    private string _value = "";

    private readonly string[] _nyelvek = { "Magyar", "Német", "Angol" };

    private async Task Submit()
    {
        var siker = await TaskService.CreateIskolaLatogatasiRequest(_value);

        if (siker)
        {
            Snackbar.Add("Az igénylést sikeresen rögzítettük!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(_value));
        }
        else
        {
            Snackbar.Add("Hiba történt a mentés során. Kérjük, próbálja újra!", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}