@using MudBlazor
@inject ITaskService TaskService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Class="mr-3" />
            <MudText Typo="Typo.h6">Törzslapi papír</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <MudContainer Style="padding: 24px 16px;">
            <MudStack Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Dark">
                    <b>Törzslapi papír igénylése</b>
                </MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                    A gombra kattintva elküldjük az igénylést a rendszerbe.
                </MudText>
            </MudStack>
        </MudContainer>
    </DialogContent>

    <DialogActions>
        <div class="px-6 pb-4 d-flex justify-space-between w-100">
            <MudButton OnClick="Cancel"
                       Variant="Variant.Text"
                       Color="Color.Default">
                Mégse
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       EndIcon="@Icons.Material.Filled.Send"
                       Color="Color.Primary"
                       OnClick="Submit"
                       Size="Size.Large">
                Küldés
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudBlazor.IMudDialogInstance MudDialog { get; set; }

    private async void Submit()
    {
        var siker = await TaskService.CreateTorzslapRequest();

        if (siker)
        {
            Snackbar.Add("Az igénylést sikeresen rögzítettük!", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("Hiba történt a mentés során. Kérjük, próbálja újra!", Severity.Error);
        }
    }

    private void Cancel() => MudDialog.Cancel();
}