@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5">
            <MudIcon Icon="@Icons.Material.Filled.School" Class="mr-3 mb-n1" />
            Érettségi Jelentkezés és Lekérés
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="max-height: 500px; overflow-y: auto" Class="pa-4">

            @* --- KORÁBBI EREDMÉNYEK LEKÉRÉSE --- *@
            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2"><b>Korábbi érettségi lekérése</b></MudText>
            <MudGrid Class="mb-6">
                <MudItem xs="12" sm="8">
                    <MudSelect T="string" Label="Válassz korábbi vizsgát" @bind-Value="_korabbiTantargy" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("Magyar nyelv és irodalom")" />
                        <MudSelectItem Value="@("Matematika")" />
                        <MudSelectItem Value="@("Történelem")" />
                        <MudSelectItem Value="@("Angol nyelv")" />
                        <MudSelectItem Value="@("Német nyelv")" />
                        <MudSelectItem Value="@("Informatika")" />
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-center">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" OnClick="Lekeres">Lekérés</MudButton>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            @* --- ÚJ JELENTKEZÉS --- *@
            <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mb-2"><b>Új jelentkezés leadása</b></MudText>
            <MudGrid>
                <MudItem xs="12" sm="7">
                    <MudSelect T="string" Label="Tantárgy" @bind-Value="_ujTantargy" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("Matematika")" />
                        <MudSelectItem Value="@("Fizika")" />
                        <MudSelectItem Value="@("Biológia")" />
                        <MudSelectItem Value="@("Kémia")" />
                        <MudSelectItem Value="@("Földrajz")" />
                        <MudSelectItem Value="@("Digitális kultúra")" />
                        <MudSelectItem Value="@("Angol nyelv")" />
                        <MudSelectItem Value="@("Német nyelv")" />
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="5">
                    <MudSelect T="string" Label="Szint" @bind-Value="_szint" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                        <MudSelectItem Value="@("Középszint")" />
                        <MudSelectItem Value="@("Emelt szint")" />
                    </MudSelect>
                </MudItem>
            </MudGrid>

        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Mégse</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Send"
                   OnClick="Submit">
            Jelentkezés beküldése
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudBlazor.IMudDialogInstance MudDialog { get; set; }

    private string _korabbiTantargy;
    private string _ujTantargy;
    private string _szint = "Középszint";

    private void Lekeres()
    {
        // Itt kezelheted a lekérést (pl. Snackbar üzenet)
        if (string.IsNullOrEmpty(_korabbiTantargy)) return;

        Console.WriteLine($"Lekérés: {_korabbiTantargy}");
    }

    private void Submit()
    {
        // Itt küldheted el a jelentkezést
        if (string.IsNullOrEmpty(_ujTantargy)) return;

        MudDialog.Close(DialogResult.Ok(new { Targy = _ujTantargy, Szint = _szint }));
    }

    private void Cancel() => MudDialog.Cancel();
}