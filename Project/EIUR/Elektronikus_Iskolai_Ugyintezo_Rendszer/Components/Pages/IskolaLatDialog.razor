@using MudBlazor

<MudDialog ContentClass="custom-dialog-width" MaxWidth="MaxWidth.None">
    <TitleContent>
        Iskolalátogatási papír
    </TitleContent>
    <DialogContent>
        <MudStack Row Class="justify-space-between mud-width-full">
            <MudSelect @bind-Value="_value" Label="Nyelv kiválasztása">
                @foreach (var nyelv in _nyelvek)
                {
                    <MudSelectItem Value="nyelv">@nyelv</MudSelectItem>
                }
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" EndIcon="@Icons.Material.Filled.Send" Color="Color.Primary">Send</MudButton>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();

    private string _value;
    private bool _modal;

    private readonly string[] _nyelvek =
    {
        "Magyar","Német", "Angol"
    };
}