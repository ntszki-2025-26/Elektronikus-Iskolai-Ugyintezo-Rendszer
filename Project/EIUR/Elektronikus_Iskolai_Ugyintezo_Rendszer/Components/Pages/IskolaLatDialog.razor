

<MudDialog Class="custom-dialog-container">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-3" Color="Color.Info" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Iskolalátogatási igazolás</MudText>
        </div>
    </TitleContent>

    <DialogContent>
        <div class="dialog-body">
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: #718096;">
                Kérjük, válassza ki, milyen nyelven szeretné igényelni az igazolást.
            </MudText>

            <MudSelect @bind-Value="_value"
                       Label="Nyelv kiválasztása"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomCenter"
                       AdornmentIcon="@Icons.Material.Filled.Language"
                       AdornmentColor="Color.Primary">
                @foreach (var nyelv in _nyelvek)
                {
                    <MudSelectItem Value="nyelv">@nyelv</MudSelectItem>
                }
            </MudSelect>
        </div>
    </DialogContent>

    <DialogActions>
        <div class="pa-4 d-flex justify-center" style="width: 100%;">
            <MudButton OnClick="Cancel" Class="mr-2">Mégse</MudButton>
            <MudButton Variant="Variant.Filled"
                       EndIcon="@Icons.Material.Filled.Send"
                       Color="Color.Primary"
                       OnClick="Submit">
                Igénylés leadása
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private void Submit() => MudDialog.Close(DialogResult.Ok(_value));

    private void Cancel() => MudDialog.Cancel();

    private string _value;
    private bool _modal;

    private readonly string[] _nyelvek =
    {
        "Magyar", "Német", "Angol"
    };
}