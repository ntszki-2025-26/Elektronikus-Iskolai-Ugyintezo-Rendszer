@page "/"
@page "/Login"
@using Microsoft.EntityFrameworkCore
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Data
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Models
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<div class="login-container">
    <div class="card login-card shadow-lg">
        <div class="card-body p-5">
            <div class="text-center mb-4">
                <i class="bi bi-mortarboard-fill school-icon"></i>
                <h3 class="fw-bold mt-2">Iskolai Ügyintézés</h3>
                <p class="text-muted">Jelentkezzen be a folytatáshoz!</p>
            </div>

            <EditForm Model="@loginModel" OnValidSubmit="LoginUser" FormName="LoginForm">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label text-secondary small fw-bold">Email cím</label>
                    <div class="input-group custom-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <InputText class="form-control no-focus"
                                   @bind-Value="loginModel.Email"
                                   placeholder="pelda@iskola.hu" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label text-secondary small fw-bold">Jelszó</label>
                    <div class="input-group custom-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>

                        <InputText type="@PasswordInputType"
                                   class="form-control no-focus"
                                   @bind-Value="loginModel.Password"
                                   placeholder="••••••••" />

                        <button type="button" class="password-toggle" @onclick="TogglePasswordVisibility">
                            <i class="bi @PasswordIcon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                    Belépés
                </button>

                @if (errorMessage != null)
                {
                    <div class="alert alert-danger mt-3 text-center p-2 small">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                    </div>
                }
            </EditForm>
        </div>
    </div>
</div>