@page "/Login"
@using Microsoft.EntityFrameworkCore
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Data
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Models
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<h3>Bejelentkezés</h3>

<EditForm Model=@loginModel OnValidSubmit="LoginUser">

    <InputText class="form-control"
               @bind-Value="loginModel.Email"
               placeholder="Email" />

    <br />

    <InputText type="password"
               class="form-control"
               @bind-Value="loginModel.Password"
               placeholder="Jelszó" />

    <br />

    <button type="submit"  class="btn btn-primary">
        Belépés
    </button>

</EditForm>

@if (errorMessage != null)
{
    <p style="color:red">@errorMessage</p>
}

@code {
    [SupplyParameterFromForm]
    public LoginModel loginModel { get; set; } = new LoginModel();

    string? errorMessage;

    async Task LoginUser()
    {
        errorMessage = null;

        // 1. Kontextus létrehozása (mivel IDbContextFactory-t használunk)
        using var db = await DbFactory.CreateDbContextAsync();

        // 2. Felhasználó keresése Email alapján
        var user = await db.Users
            .FirstOrDefaultAsync(u => u.Email == loginModel.Email);

        // 3. Jelszó ellenőrzése és átirányítás
        if (user != null && BCrypt.Net.BCrypt.Verify(loginModel.Password, user.Password))
        {
            // HA JÓ A JELSZÓ: Átirányítás például az Admin vagy Home oldalra
            Nav.NavigateTo("/admin");
        }
        else
        {
            // HA ROSSZ: Hibaüzenet megjelenítése
            errorMessage = "Hibás email cím vagy jelszó!";
        }
    }

    public class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}