
@page "/login"

<div class="login-page">

    <MudPaper Class="login-card" Elevation="4">

        <MudText Typo="Typo.h5" Align="Align.Center" Class="login-title">
            Log In
        </MudText>

        <MudTextField Label="Email"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      @bind-Value="email"
                      Class="mb-3" />

        <MudTextField Label="Password"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      FullWidth="true"
                      @bind-Value="password" />

       

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Error"
                   FullWidth="true"
                   OnClick="Logi">
            Bejelentkezés
        </MudButton>

    </MudPaper>

</div>

@code {

    string email;
    string password;

    void Logi()
    {
       
    }

}

