

<MudDialog>
    <TitleContent>
        MÁK / Árvasági papír 
    </TitleContent>
    <DialogContent>
        <MudContainer Class="d-flex justify-center align-center" Style="height: 100px;">
            <MudText Typo="Typo.h5" Align="Align.Center"><b>MÁK / Árvasági papír igénylése</b></MudText>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <div class="pa-4 d-flex justify-center" style="width: 100%;">
            <MudButton OnClick="Cancel" Class="mr-2">Mégse</MudButton>
            <MudButton Variant="Variant.Filled"
                       EndIcon="@Icons.Material.Filled.Send"
                       Color="Color.Primary"
                       OnClick="Submit">
                Küldés
            </MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudBlazor.IMudDialogInstance MudDialog { get; set; }

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();
}