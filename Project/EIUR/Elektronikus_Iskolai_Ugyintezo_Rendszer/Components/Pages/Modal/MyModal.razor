@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Models
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Felhasználó módosítása</MudText>
    </TitleContent>
    <DialogContent>
        <div class="container-fluid">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label small fw-bold text-muted">Azonosító (ID)</label>
                    <input class="form-control bg-light" type="text" disabled @bind="id" />
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Vezetéknév</label>
                    <input class="form-control" type="text" @bind="lastName" />
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Középsőnév</label>
                    <input class="form-control" type="text" @bind="middleName" />
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Keresztnév</label>
                    <input class="form-control" type="text" @bind="firstName" />
                </div>

                <div class="col-12">
                    <label class="form-label small fw-bold">Email cím</label>
                    <input class="form-control" type="email" @bind="email" />
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold">Telefonszám</label>
                    <input class="form-control" type="tel" @bind="phoneNumber" />
                </div>

                <div class="col-md-6">
                    <label class="form-label small fw-bold text-primary">Szerepkör kiválasztása</label>
                    <select class="form-select border-primary" @bind="roleId">
                        <option value="1">Diák</option>
                        <option value="2">Osztályfőnök</option>
                        <option value="3">Igazgatóhelyettes</option>
                        <option value="4">Szakképzésvezető</option>
                        <option value="5">Igazgató</option>
                        <option value="6">Gazdasági Titkár</option>
                        <option value="7">Titkár</option>
                        <option value="8">Könyvtáros</option>
                        <option value="9">Admin</option>
                    </select>
                </div>

                <div class="col-12">
                    <label class="form-label small fw-bold">Új jelszó (Hagyd üresen a megtartáshoz)</label>
                    <input class="form-control" type="password" @bind="password" placeholder="********" />
                </div>

                <div class="col-12">
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" id="isEnabledCheck" @bind="isEnabled">
                            <label class="form-check-label fw-bold" for="isEnabledCheck">Fiók állapota: @(isEnabled ? "Aktív" : "Tiltott")</label>
                        </div>
                    </div>
                </div>
            </div>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" OnClick="Cancel">Mégse</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="px-10" OnClick="Submit">Mentés</MudButton>
        </DialogActions>
    </MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialogInstance { get; set; } = default!;
    [Parameter] public User EditedUser { get; set; } = default!;

    private Guid id;
    private string firstName = "";
    private string lastName = "";
    private string middleName = "";
    private bool isEnabled;
    private string email = "";
    private string phoneNumber = "";
    private string password = "";
    private int roleId;

    protected override void OnParametersSet()
    {
        if (EditedUser is not null)
        {
            id = EditedUser.Id;
            firstName = EditedUser.FirstName;
            lastName = EditedUser.LastName;
            middleName = EditedUser.MiddleName;
            isEnabled = EditedUser.IsEnabled;
            email = EditedUser.Email;
            phoneNumber = EditedUser.PhoneNumber;
            roleId = EditedUser.RoleId;
            password = "";
        }
    }

    private void Cancel() => MudDialogInstance.Cancel();

    private void Submit()
    {
        string finalPassword = string.IsNullOrWhiteSpace(password)
            ? EditedUser.Password
            : BCrypt.Net.BCrypt.HashPassword(password);

        var updated = new User
        {
            Id = id,
            FirstName = firstName,
            LastName = lastName,
            MiddleName = EditedUser.MiddleName,
            IsEnabled = isEnabled,
            Email = email,
            PhoneNumber = phoneNumber,
            Password = finalPassword,
            RoleId = roleId
        };
        
        MudDialogInstance.Close(DialogResult.Ok(updated));
    }
}