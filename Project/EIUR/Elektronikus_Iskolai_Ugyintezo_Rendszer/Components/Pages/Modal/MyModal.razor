@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Models
<MudDialog>
    <TitleContent>
        Felhasználó módosítása
    </TitleContent>
    <DialogContent>
        Id: <input class="form-control mb-1" type="text" disabled @bind="id"/><br />
        Vezetéknév: <input class="form-control mb-1" type="text" @bind="firstName" /><br />
        Második név: <input class="form-control mb-1" type="text" @bind="middleName" /><br />
        Keresztnév: <input class="form-control mb-1" type="text" @bind="lastName" /><br />
        Aktív: <input type="checkbox" @bind="isEnabled" /><br />
        Email: <input class="form-control mb-1" type="email" @bind="email" /><br />
        Telefonszám: <input class="form-control mb-1" type="tel" @bind="phoneNumber" /><br />
        Jelszó: <input class="form-control mb-1" type="password" @bind="password" /><br />
        Szerepkör: <input class="form-control mb-1" type="number" @bind="roleId" /><br />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Mégse</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">OK</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter] IMudDialogInstance MudDialogInstance { get; set; } = default!;

    [Parameter] public User EditedUser { get; set; } = default!;

    private Guid id;
    private string firstName = "";
    private string? middleName;
    private string lastName = "";
    private bool isEnabled;
    private string email = "";
    private string phoneNumber = "";
    private string password = "";
    private int roleId;

    protected override void OnParametersSet()
    {
        if (EditedUser is not null)
        {
            id          = EditedUser.Id;
            firstName   = EditedUser.FirstName;
            middleName  = EditedUser.MiddleName;
            lastName    = EditedUser.LastName;
            isEnabled   = EditedUser.IsEnabled == 1;
            email       = EditedUser.Email;
            phoneNumber = EditedUser.PhoneNumber;
            password    = EditedUser.Password;
            roleId      = EditedUser.RoleId;
        }
    }

    private void Cancel() => MudDialogInstance.Cancel();

    private void Submit()
    {
        // Ha a jelszó mező megváltozott (nem egyezik az eredeti hash-sel), lehashelje
        string finalPassword;

        // Ellenőrizzük, hogy a beviteli mező (password) nem üres-e
        if (!string.IsNullOrWhiteSpace(password))
        {
            // Ha írt be valamit, az az új jelszava, tehát lehash-eljük
            finalPassword = BCrypt.Net.BCrypt.HashPassword(password);
        }
        else
        {
            // Ha üres a mező, megtartjuk a régi, már adatbázisban lévő hash-t
            finalPassword = EditedUser.Password;
        }

        var updated = new User
        {
            Id          = id,
            FirstName   = firstName,
            MiddleName  = middleName,
            LastName    = lastName,
            IsEnabled   = (byte)(isEnabled ? 1 : 0),
            Email       = email,
            PhoneNumber = phoneNumber,
            Password    = finalPassword,
            RoleId      = roleId
        };
        MudDialogInstance.Close(DialogResult.Ok(updated));
    }
}
