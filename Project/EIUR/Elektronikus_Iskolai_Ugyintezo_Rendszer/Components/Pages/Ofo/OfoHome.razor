@page "/OfoHome"
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Models
@using Elektronikus_Iskolai_Ugyintezo_Rendszer.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Osztályfőnök")]
@inject ISnackbar Snackbar
@inject AbsenceService AbsenceService
@rendermode InteractiveServer
@inject UserManagementService UserManagementService

<MudThemeProvider IsDarkMode="false" />

<MudLayout>
    <MudDrawer Open="true" Elevation="0" Variant="@DrawerVariant.Responsive">
        <MudDrawerHeader Class="pa-8">
            <MudButton Typo="Typo.h5" Style="color: black; font-weight: 800;">@OfoName</MudButton>
        </MudDrawerHeader>

        <MudNavMenu Class="nav-menu-custom">
            <MudNavLink Href="/OfoHome" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Áttekintés</MudNavLink>
            <MudNavLink Href="/hianyzasok" Icon="@Icons.Material.Filled.EventBusy">Hiányzások</MudNavLink>
            <MudNavLink Href="/osztaly-list" Icon="@Icons.Material.Filled.FormatListNumbered">Osztálynévsor</MudNavLink>

            <div class="pa-4 mt-auto">
                <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Logout" Style="border-radius: 10px;">
                    Kijelentkezés
                </MudButton>
            </div>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="main-bg">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-10">

            <div class="d-flex align-center justify-space-between mb-8">
                <MudText Typo="Typo.h4" Style="font-weight: 800; color: #1a282c;">Osztályfőnöki Felügyelet (12.B)</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Load" StartIcon="@Icons.Material.Filled.Refresh">Frissítés</MudButton>
            </div>

            <div class="section-card mb-6">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.HistoryEdu" Color="Color.Warning" Class="mr-3" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Bejelentett hiányzások</MudText>
                </div>

                <MudExpansionPanels MultiExpansion="true" Elevation="0">

                    @if (absences != null)
                    {
                        @foreach (var a in absences)
                        {
                            <MudExpansionPanel Class="task-item-box">
                                <TitleContent>
                                    <div class="d-flex align-center w-100">
                                        <div class="mr-4" style="width: 6px; height: 30px; background-color: #FF9800; border-radius: 3px;"></div>
                                        <div class="flex-grow-1">
                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@a.SenderName</MudText>
                                            <MudText Typo="Typo.caption">Beküldve: @a.ReportDate</MudText>
                                        </div>
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">Rendszerből</MudChip>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <div class="pa-4">
                                        <MudText Typo="Typo.body2"><b>Üzenet/Indoklás:</b> @a.Message</MudText>
                                    </div>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    }


                    @foreach (var hianyzas in _hianyzasok)
                    {
                        <MudExpansionPanel Class="task-item-box">
                            <TitleContent>
                                <div class="d-flex align-center w-100">
                                    <div class="mr-4" style="width: 6px; height: 30px; background-color: #FF9800; border-radius: 3px;"></div>
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@hianyzas.StudentName</MudText>
                                        <MudText Typo="Typo.caption">Időtartam: @hianyzas.StartDate.ToShortDateString() - @hianyzas.EndDate.ToShortDateString()</MudText>
                                    </div>
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text">Előre jelzett</MudChip>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div class="pa-4">
                                    <MudText Typo="Typo.body2"><b>Indoklás:</b> @hianyzas.Reason</MudText>
                                    <div class="d-flex justify-end mt-4">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                   OnClick="() => TudomasulVetel(hianyzas)"
                                                   EndIcon="@Icons.Material.Filled.Check" Style="border-radius: 8px;">
                                            Tudomásul veszem
                                        </MudButton>
                                    </div>
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </div>


            <div class="section-card mt-6">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" Class="mr-3" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Adminisztratív kérések</MudText>
                </div>

                <MudExpansionPanels MultiExpansion="true" Elevation="0">
                    @foreach (var task in _tasks)
                    {
                        <MudExpansionPanel Class="task-item-box">
                            <TitleContent>
                                <div class="d-flex align-center w-100">
                                    <div class="mr-4" style="width: 6px; height: 30px; background-color: @(task.IsDone ? "#4CAF50" : "#2196F3"); border-radius: 3px;"></div>
                                    
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.subtitle1" Style="@($"font-weight: 700; color: {(task.IsDone ? "#4CAF50" : "#2d3748")};")">
                                            @task.StudentName - @task.DocumentType
                                        </MudText>
                                        <MudText Typo="Typo.caption">Beküldve: @task.Date.ToShortDateString()</MudText>
                                    </div>

                                    @if (task.IsDone)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                                    }
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div class="pa-4">
                                    <MudText Typo="Typo.body2" Class="mb-4">@task.Description</MudText>
                                    <div class="d-flex justify-end mt-4">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="@(task.IsDone ? Color.Default : Color.Info)"
                                                   OnClick="(() => HandleTaskResponse(task))"
                                                   Disabled="@task.IsDone"
                                                   EndIcon="@(task.IsDone ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Send)"
                                                   Style="border-radius: 8px;">
                                            @(task.IsDone ? "Elküldve" : "Visszajelzés küldése")
                                        </MudButton>
                                    </div>
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </div>

        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {




    private List<NotificationDto>? absences;
    private async Task Load()
    {
        try
        {
            absences = await AbsenceService.GetNotificationsByRole(2);
            StateHasChanged(); 
        }
        catch (Exception)
        {
            Snackbar.Add("Hiba történt az adatok lekérésekor!", Severity.Error);
        }
    }

    private void TudomasulVetel(Hianyzas h)
    {
        _hianyzasok.Remove(h);
        Snackbar.Add($"{h.StudentName} hiányzása rögzítve.", MudBlazor.Severity.Success);
    }

    private void HandleTaskResponse(UserTask task)
    {
        task.IsDone = true;
        Snackbar.Add($"{task.StudentName} kérése feldolgozva!", MudBlazor.Severity.Info);
        StateHasChanged();
    }

    private List<Hianyzas> _hianyzasok = new()
    {
    };

    private List<UserTask> _tasks = new()
    {
        new UserTask { StudentName = "Szabó Zoltán", DocumentType = "Iskolalátogatási igazolás", Date = DateTime.Now, Description = "MÁK igényléshez szükséges.", IsDone = false }
    };

    public class Hianyzas
    {
        public string StudentName { get; set; } = "";
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public string Reason { get; set; } = "";
    }

    public class UserTask
    {
        public string StudentName { get; set; } = "";
        public string DocumentType { get; set; } = "";
        public DateTime Date { get; set; }
        public string Description { get; set; } = "";
        public bool IsDone { get; set; }
    }

    private string OfoName { get; set; } = "Betöltés...";

    protected override async Task OnInitializedAsync()
    {
        OfoName = await UserManagementService.GetCurrentUserNameAsync() ?? "Ismeretlen Osztályfőnök";
    }
}