@page "/OfoHome2"
@inject ISnackbar Snackbar
@rendermode InteractiveServer
<MudThemeProvider IsDarkMode="false" />

<MudLayout>
    @* --- OLDALSÁV --- *@
    <MudDrawer Open="true" Elevation="0" Variant="@DrawerVariant.Responsive">
        <MudDrawerHeader Class="pa-8">
            <MudText Typo="Typo.h5" Style="color: white; font-weight: 800;">Osztályfőnök</MudText>
        </MudDrawerHeader>

        <MudNavMenu Class="nav-menu-custom">
            <MudNavLink Href="/OsztalyfonokHome" Icon="@Icons.Material.Filled.Dashboard" Match="NavLinkMatch.All">Áttekintés</MudNavLink>
            <MudNavLink Href="/hianyzasok" Icon="@Icons.Material.Filled.EventBusy">Hiányzások</MudNavLink>
            <MudNavLink Href="/osztaly-list" Icon="@Icons.Material.Filled.FormatListNumbered">Osztálynévsor</MudNavLink>
            
            <div class="pa-4 mt-auto">
                <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true" 
                           StartIcon="@Icons.Material.Filled.Logout" Style="border-radius: 10px;">
                    Kijelentkezés
                </MudButton>
            </div>
        </MudNavMenu>
    </MudDrawer>

    @* --- FŐ TARTALOM --- *@
    <MudMainContent Class="main-bg">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-10">
            
            <MudText Typo="Typo.h4" Class="mb-8" Style="font-weight: 800; color: #1a202c;">Osztályfőnöki Felügyelet (12.B)</MudText>

            @* 1. SZEKCIÓ: HIÁNYZÁS ELŐREJELZÉSEK (ÚJ FUNKCIÓ) *@
            <div class="section-card">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.HistoryEdu" Color="Color.Warning" Class="mr-3" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Bejelentett hiányzások</MudText>
                </div>

                <MudExpansionPanels MultiExpansion="true" Elevation="0">
                    @foreach (var hianyzas in _hianyzasok)
                    {
                        <MudExpansionPanel Class="task-item-box">
                            <TitleContent>
                                <div class="d-flex align-center w-100">
                                    <div class="mr-4" style="width: 6px; height: 30px; background-color: #FF9800; border-radius: 3px;"></div>
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@hianyzas.StudentName</MudText>
                                        <MudText Typo="Typo.caption">Időtartam: @hianyzas.StartDate.ToShortDateString() - @hianyzas.EndDate.ToShortDateString()</MudText>
                                    </div>
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Text">Előre jelzett</MudChip>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div class="pa-4">
                                    <MudText Typo="Typo.body2"><b>Indoklás:</b> @hianyzas.Reason</MudText>
                                    <div class="d-flex justify-end mt-4">
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                                                   OnClick="(() => TudomasulVetel(hianyzas))"
                                                   EndIcon="@Icons.Material.Filled.Check" Style="border-radius: 8px;">
                                            Tudomásul veszem
                                        </MudButton>
                                    </div>
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </div>

            @* 2. SZEKCIÓ: EGYÉB ÜGYINTÉZÉSEK *@
            <div class="section-card">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" Class="mr-3" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Adminisztratív kérések</MudText>
                </div>

                <MudExpansionPanels MultiExpansion="true" Elevation="0">
                    @foreach (var task in _tasks)
                    {
                        <MudExpansionPanel Class="task-item-box">
                            <TitleContent>
                                <div class="d-flex align-center w-100">
                                    <div class="mr-4" style="width: 6px; height: 30px; background-color: #2196F3; border-radius: 3px;"></div>
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@task.StudentName - @task.DocumentType</MudText>
                                        <MudText Typo="Typo.caption">Beküldve: @task.Date.ToShortDateString()</MudText>
                                    </div>
                                </div>
                            </TitleContent>
                            <ChildContent>
                                <div class="pa-4">
                                    <MudText Typo="Typo.body2">@task.Description</MudText>
                                    <div class="d-flex justify-end mt-4">
                                        <MudButton Variant="Variant.Filled" Color="Color.Info" Style="border-radius: 8px;">Visszajelzés</MudButton>
                                    </div>
                                </div>
                            </ChildContent>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </div>

        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private void TudomasulVetel(Hianyzas h)
    {
        _hianyzasok.Remove(h);
        Snackbar.Add($"{h.StudentName} hiányzása rögzítve.", MudBlazor.Severity.Success);
    }

    private List<Hianyzas> _hianyzasok = new()
    {
        new Hianyzas { StudentName = "Kovács Adél", StartDate = DateTime.Now.AddDays(2), EndDate = DateTime.Now.AddDays(5), Reason = "Családi esemény miatt távol lesz." },
        new Hianyzas { StudentName = "Nagy Péter", StartDate = DateTime.Now.AddDays(1), EndDate = DateTime.Now.AddDays(1), Reason = "Jogosítvány elméleti vizsga." }
    };

    private List<UserTask> _tasks = new()
    {
        new UserTask { StudentName = "Szabó Zoltán", DocumentType = "Iskolalátogatási igazolás", Date = DateTime.Now, Description = "MÁK igényléshez szükséges." }
    };

    public class Hianyzas
    {
        public string StudentName { get; set; } = "";
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public string Reason { get; set; } = "";
    }

    public class UserTask
    {
        public string StudentName { get; set; } = "";
        public string DocumentType { get; set; } = "";
        public DateTime Date { get; set; }
        public string Description { get; set; } = "";
    }
}