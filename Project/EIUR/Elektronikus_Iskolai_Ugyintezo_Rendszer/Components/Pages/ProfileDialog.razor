@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-3" />
           Diak neve
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudContainer Style="max-height: 400px; overflow-y: auto">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_nev" Label="Név" Variant="Variant.Outlined" ReadOnly="_readOnly" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined" ReadOnly="_readOnly" />
                </MudItem>
            </MudGrid>
        </MudContainer>
    </DialogContent>
    <DialogActions>
        @if (_readOnly)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" OnClick="EnableEditing">Módosítás</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveData">Mentés</MudButton>
        }
        <MudButton Color="Color.Primary" OnClick="Submit">Bezárás</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudBlazor.IMudDialogInstance MudDialog { get; set; }

    private bool _readOnly = true;
    private string _nev = "Profil neve";
    private string _email = "profil.eamil@iskola.hu";


    private void EnableEditing()
    {
        _readOnly = false;
    }


    private void SaveData()
    {
        _readOnly = true;

    }

    void Submit() => MudDialog.Close(MudBlazor.DialogResult.Ok(true));
}