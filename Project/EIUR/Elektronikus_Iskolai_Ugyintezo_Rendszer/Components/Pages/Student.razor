@page "/student"
@rendermode InteractiveServer

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
    <MudLayout>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="@ToggleDrawer" />
                <MudSpacer />
            <MudDrawer @bind-Open="@_open" Elevation="1" Variant="DrawerVariant.Temporary">
                <MudDrawerHeader>
                    <MudText Typo="Typo.h6">Elektronikus Iskolai Ügyintéző Rendszer</MudText>
                </MudDrawerHeader>
                <MudNavMenu>
                    <MudNavLink Match="NavLinkMatch.All">Profil</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All">Értesítések</MudNavLink>
                    <MudNavLink Match="NavLinkMatch.All">Kilépés</MudNavLink>
                </MudNavMenu>
            </MudDrawer>
    </MudLayout>
<MudContainer MaxWidth="MaxWidth.Medium" Class="page-container">

    <div class="menu-container">

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="menu-button" Href="#">
            Iskolalátogatási papír
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Class="menu-button" Href="#">
            Probléma jelentés
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Info" Class="menu-button" Href="#">
            Ideiglenes igazolvány
        </MudButton>

        <MudButton Variant="Variant.Filled" Color="Color.Warning" Class="menu-button" Href="#">
            Hiányzás előrejelzés
        </MudButton>

    </div>

</MudContainer>

@code{
    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}