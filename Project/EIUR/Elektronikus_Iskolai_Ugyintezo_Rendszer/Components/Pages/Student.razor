@page "/student"
@rendermode InteractiveServer

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="@ToggleDrawer" />
    <MudSpacer />

    <MudDrawer @bind-Open="@_open" Elevation="1" Variant="DrawerVariant.Temporary">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Elektronikus Iskolai Ügyintéző Rendszer</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Match="NavLinkMatch.All">Profil</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All">Értesítések</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All">Kilépés</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
</MudLayout>
<MudContainer MaxWidth="MaxWidth.Medium" Class="page-container">
    <div class="menu-container">
        @foreach (var ugy in ugyek)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="menu-button">
                @ugy
            </MudButton>
        }
    </div>
</MudContainer>

@code{
    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
    private List<string> ugyek = new()
    {
        "Iskolalátogatási igazolás magyar, német",
        "Jogviszony igazolás",
        "MÁK igazolás / árvásági dokumentum",
        "Érettségi vizsga adatbegyűjtés",
        "Lakcím adatok változásának bejelentése",
        "Korábbi érettségi vizsgák törzslap másolata"
    };
}