@page "/tanaradd"
@rendermode InteractiveServer

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

    <MudLayout>
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="@ToggleDrawer" />
            <MudSpacer />
        <MudDrawer @bind-Open="@_open" Elevation="1" Variant="DrawerVariant.Temporary">
            <MudDrawerHeader>
                <MudText Typo="Typo.h6">Elektronikus Iskolai Ügyintéző Rendszer</MudText>
            </MudDrawerHeader>
            <MudNavMenu>
                <MudNavLink Match="NavLinkMatch.All">Profil</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All">Értesítések</MudNavLink>
                <MudNavLink Match="NavLinkMatch.All">Kilépés</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
    </MudLayout>

<MudContainer MaxWidth="MaxWidth.False" Class="page-container">

  
    <MudPaper Elevation="3" Class="content-card">

        <MudTable T="object" Items="@rows" Dense="true" Hover="true" Class="students-table">

            <HeaderContent>
                <MudTh>Név</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Lakhely</MudTh>
                <MudTh>OM azonosító</MudTh>
                <MudTh>Évfolyam</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd></MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error" />
                </MudTd>
            </RowTemplate>

        </MudTable>

     
        <div class="action-buttons">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary">
                Import
            </MudButton>

            <MudButton Variant="Variant.Filled" Color="Color.Success">
                Tanuló felvétele
            </MudButton>
        </div>

    </MudPaper>

</MudContainer>


@code {
    private List<object> rows = Enumerable.Range(0, 10).Select(x => new object()).ToList();

    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}