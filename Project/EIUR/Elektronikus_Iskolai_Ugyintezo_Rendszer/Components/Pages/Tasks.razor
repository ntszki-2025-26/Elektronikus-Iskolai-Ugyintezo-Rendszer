@page "/tasks"
@rendermode InteractiveServer

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="@ToggleDrawer" />
    <MudSpacer />
    <MudDrawer @bind-Open="@_open" Elevation="1" Variant="DrawerVariant.Temporary">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Feladatok</MudText>
        </MudDrawerHeader>
        <MudNavMenu>
            <MudNavLink Match="NavLinkMatch.All">Profil</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All">Értesítések</MudNavLink>
            <MudNavLink Match="NavLinkMatch.All">Kilépés</MudNavLink>
        </MudNavMenu>
    </MudDrawer>
</MudLayout>
<MudContainer MaxWidth="MaxWidth.Medium" Class="page-container">

    <div class="task-list">

        @foreach (var task in tasks)
        {
            <MudPaper Elevation="4" Class="task-card">

                <MudText Typo="Typo.h6" Class="task-text">
                    @task
                </MudText>

                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Color="Color.Success"
                         Size="Size.Large" />

            </MudPaper>
        }

    </div>

</MudContainer>

@code {
    private List<string> tasks = new()
    {
        "Feladat",
        "Feladat",
        "Feladat"
    };

    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}