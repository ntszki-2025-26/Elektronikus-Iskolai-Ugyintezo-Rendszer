@page "/tasks"

<style>

.page-container {
    min-height: 100vh;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
}

.top-bar {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    gap: 10px;
}

.top-button {
    border: 1px solid #999;
    border-radius: 6px;
    padding: 6px 12px;
    background: none;
}

.task-container {
    display: flex;
    flex-direction: column;
    gap: 25px;
}

.task-card {
    width: 250px;
    height: 60px;
    border: 1px solid #999;
    border-radius: 6px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
}

.task-text {
    font-size: 16px;
}

.check {
    position: absolute;
