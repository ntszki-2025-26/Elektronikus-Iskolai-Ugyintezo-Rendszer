@page "/TitkarHome"
@inject ISnackbar Snackbar
@using Microsoft.AspNetCore.Authorization
@using DbTask = Elektronikus_Iskolai_Ugyintezo_Rendszer.Models.Taskses
@attribute [Authorize(Roles = "Titkár")]
@rendermode InteractiveServer
@inject RequestService RequestService
<MudThemeProvider IsDarkMode="false" />


<MudLayout>
    <MudDrawer Open="true" Elevation="0" Variant="@DrawerVariant.Responsive">
        <MudDrawerHeader Class="pa-8">
            <MudText Typo="Typo.h5" Style="color: white; font-weight: 800;">Tanári Panel</MudText>
        </MudDrawerHeader>

        <MudNavMenu Class="nav-menu-custom">
            <MudNavLink Href="/SzakkepzesvezetoHome" Icon="@Icons.Material.Filled.Assignment" Match="NavLinkMatch.All">Profil</MudNavLink>
            <MudNavLink Href="/osztalyok" Icon="@Icons.Material.Filled.People">Osztályaim</MudNavLink>

            <div class="logout-btn-box mt-4">
                <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-3" />
                <span>Kijelentkezés</span>
            </div>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="main-bg">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-10">
            <MudText Typo="Typo.h4" Class="mb-8" Style="font-weight: 800; color: #1a202c;">Aktuális feladatok</MudText>


            <div class="section-container">
                <MudExpansionPanels MultiExpansion="true" Elevation="0">
                    @if (_tasks == null || !_tasks.Any())
                    {
                        <MudAlert Severity="Severity.Info">Jelenleg nincs feldolgozandó kérelem.</MudAlert>
                    }
                    else
                    {
                        @foreach (var task in _tasks)
                        {
                            <MudExpansionPanel Class="task-item-box">
                                <TitleContent>
                                    <div class="d-flex align-center w-100 py-1">

                                        <div class="mr-4" style="width: 8px; height: 30px; background-color: @(task.IsDone ? "#4CAF50" : "#FF5252"); border-radius: 5px;"></div>
                                        <div class="flex-grow-1">

                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">@task.BaseTask.Title</MudText>
                                            <MudText Typo="Typo.caption">Tanuló: @task.StudentName | Típus: @task.DocumentType</MudText>
                                        </div>
                                        <div>

                                            <MudText Typo="Typo.caption">Beküldve: @task.BaseTask.ReportDate.ToShortDateString()</MudText>
                                        </div>
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <div class="pa-4">
                                        <MudText Typo="Typo.body2">@task.Description</MudText>
                                        <div class="d-flex justify-end mt-4">
                                            <MudButton Variant="Variant.Filled"
                                                       Color="@(task.IsDone ? Color.Default : Color.Primary)"
                                                       OnClick="@(() => HandleResponse(task))">
                                                @(task.IsDone ? "Elvégezve" : "Visszajelzés küldése")
                                            </MudButton>
                                        </div>
                                    </div>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    }
                </MudExpansionPanels>
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {

    private List<TaskDisplayModel> _tasks;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        try
        {
            var rawData = await RequestService.GetRequestsAsync();

            if (rawData != null)
            {
                _tasks = rawData

                    .OrderByDescending(t => t.ReportDate)
                    .Select(t => new TaskDisplayModel
                    {
                        BaseTask = t,
                        IsDone = false,
                        StudentName = "Betöltés...",
                        DocumentType = "Igazolás"
                    }).ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Hiba a betöltés során: {ex.Message}");
        }
    }

    private async Task HandleResponse(TaskDisplayModel task)
    {

        task.IsDone = true;
        StateHasChanged();
    }
}