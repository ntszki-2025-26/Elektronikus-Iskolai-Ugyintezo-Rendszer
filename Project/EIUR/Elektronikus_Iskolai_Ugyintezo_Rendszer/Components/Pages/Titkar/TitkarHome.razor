@page "/TitkarHome"
@inject ISnackbar Snackbar
@using Microsoft.AspNetCore.Authorization
@using DbTask = Elektronikus_Iskolai_Ugyintezo_Rendszer.Models.Taskses
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Titkár")]
@rendermode InteractiveServer
@inject RequestService RequestService
@inject UserManagementService UserManagementService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject AbsenceService AbsenceService
@inject AuthenticationStateProvider AuthStateProvider




<MudThemeProvider IsDarkMode="false" />

<MudLayout>
    <MudDrawer Open="true" Elevation="0" Variant="@DrawerVariant.Responsive">
        <MudDrawerHeader Class="pa-8">
            <MudText Typo="Typo.h5" Style="color: black; font-weight: 800;">@TitkarName</MudText>
        </MudDrawerHeader>

        <MudNavMenu Class="nav-menu-custom">
            <div class="pa-4 mt-auto">

                <div class="logout-wrapper">

                    <form id="logout-form" action="/" method="post" style="display: none;">
                        <AntiforgeryToken />
                    </form>


                    <div class="logout-btn-box" @onclick="HandleLogout" style="cursor: pointer;">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="mr-3" />
                        <span>Kijelentkezés</span>
                    </div>
                </div>
            </div>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="main-bg">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-10">

            <MudText Typo="Typo.h4" Class="mb-8" Style="font-weight: 800; color: #1a202c;">Titkár Felület</MudText>

            @* --- ADMIN KÉRÉSEK SZEKCIÓ --- *@
            <div class="section-card">
                <div class="d-flex align-center mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" Class="mr-3" />
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">Adminisztratív kérések</MudText>
                </div>

                <MudExpansionPanels MultiExpansion="true" Elevation="0">
                    @if (adminNotifications != null)
                    {
                        @foreach (var task in adminNotifications)
                        {
                            <MudExpansionPanel Class="task-item-box">
                                <TitleContent>
                                    <div class="d-flex align-center w-100">
                                        <div class="mr-4" style="width: 6px; height: 30px; background-color: @(GetStateColor(task.State)); border-radius: 3px;"></div>

                                        <div class="flex-grow-1">
                                            <MudText Typo="Typo.subtitle1" Style="@($"font-weight: 700; color: {(task.State == 2 ? "#4CAF50" : "#2d3748")};")">
                                                @task.SenderName - @task.Title
                                            </MudText>
                                            <div class="d-flex align-center">
                                                <MudText Typo="Typo.caption" Class="mr-2">Beküldve: @task.ReportDate.ToShortDateString()</MudText>
                                                <MudChip T="string" Size="Size.Small" Color="@GetStateColor(task.State)" Variant="Variant.Text" Style="font-size: 10px;">
                                                    @GetStateText(task.State)
                                                </MudChip>
                                            </div>
                                        </div>

                                        @if (task.State == 2)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-2" />
                                        }
                                    </div>
                                </TitleContent>
                                <ChildContent>
                                    <div class="pa-4">
                                        <MudText Typo="Typo.body2" Class="mb-4">@task.Message</MudText>
                                        <div class="d-flex justify-end gap-2 mt-4">
                                            @if (task.State != 2)
                                            {
                                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                                           OnClick="@(() => FrissitAllapot(task, 3))"
                                                           Size="Size.Small">
                                                    Aláírás szükséges
                                                </MudButton>
                                                <MudButton Variant="Variant.Filled" Color="Color.Info"
                                                           OnClick="@(() => FrissitAllapot(task, 2))"
                                                           EndIcon="@Icons.Material.Filled.Send"
                                                           Style="border-radius: 8px;">
                                                    Elkészült
                                                </MudButton>
                                            }
                                        </div>
                                    </div>
                                </ChildContent>
                            </MudExpansionPanel>
                        }
                    }
                </MudExpansionPanels>
            </div>

        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private void HandleLogout()
    {
        Nav.NavigateTo("/", forceLoad: true);
    }
    private string TitkarName { get; set; } = "Betöltés...";
    private List<NotificationDto>? allNotifications;

    // Szűrt listák az adatbázisból
    private List<NotificationDto> absenceNotifications => allNotifications?
        .Where(x => x.Title == "Hiányzás bejelentés").ToList() ?? new();

    private List<NotificationDto> adminNotifications => allNotifications?
        .Where(x => x.Title != "Hiányzás bejelentés").ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        await InitialLoad();
        await LoadData();
    }

    private async Task FrissitAllapot(NotificationDto task, int ujAllapot)
    {
        // 1. Frissítés az adatbázisban a Service segítségével
        await UserManagementService.StateChange(task.TaskId, ujAllapot);
    
        // 2. Frissítés a UI-on a visszajelzéshez
        task.State = ujAllapot;
        Snackbar.Add($"Állapot módosítva: {GetStateText(ujAllapot)}", Severity.Info);
        StateHasChanged();
    }


    private async Task InitialLoad()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                TitkarName = await UserManagementService.GetCurrentUserNameAsync() ?? "Ismeretlen Titkár";
            }
        }
        catch { TitkarName = "Hiba"; }
    }

    private async Task LoadData()
    {
        allNotifications = await AbsenceService.GetNotificationsByRole(5); 
        StateHasChanged();
    }

    private void TudomasulVetel(NotificationDto h)
    {
        // Itt törölheted vagy archiválhatod
        allNotifications?.Remove(h);
        Snackbar.Add($"{h.SenderName} hiányzása rögzítve.", Severity.Success);
    }

    // Állapot segédfüggvények
    private string GetStateText(int? state) => state switch
    {
        0 => "Beérkezett",
        1 => "Folyamatban",
        2 => "Elkészült",
        3 => "Aláírásra vár",
        _ => "Ismeretlen"
    };

    private Color GetStateColor(int? state) => state switch
    {
        0 => Color.Error,
        1 => Color.Warning,
        2 => Color.Success,
        3 => Color.Secondary,
        _ => Color.Default
    };
}